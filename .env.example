# ==========================================
# UNITY-DROP FRONTEND ENVIRONMENT CONFIG (.example)
# ==========================================

# 1. Main Application Configuration
# This is the dynamic URL used by Next.js for SEO, sitemaps, and metadata.
# Local: http://localhost:3000
# Production: https://unitydrop.pk
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. API Connection
# Local: http://localhost:8000/api
# Production: https://api.unitydrop.pk/api
NEXT_PUBLIC_Backend_URL=http://localhost:8000/api

# 3. Security
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# 4. Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key
