# Frontend Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend URL Configuration (Rewrites proxy /api requests to API_URL)
NEXT_PUBLIC_Backend_URL=/api
API_URL=http://localhost:8000

# Google reCAPTCHA v2 Site Key (Client-side)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Email Bridge Configuration (For sending Gmail via Vercel without Render SMTP port blocks)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
INTERNAL_EMAIL_SECRET=unity_drop_internal_email_secret_2026
